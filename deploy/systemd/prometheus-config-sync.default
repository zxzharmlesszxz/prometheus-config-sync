PROMETHEUS_CONFIG_SYNC_SOURCE_URL=http://127.0.0.1:9876
PROMETHEUS_CONFIG_SYNC_SOURCE_TOKEN=
PROMETHEUS_CONFIG_SYNC_PROMETHEUS_RELOAD_URL=http://127.0.0.1:9090/-/reload
PROMETHEUS_CONFIG_SYNC_OUTPUT_DIR=/etc/prometheus/generated
PROMETHEUS_CONFIG_SYNC_PROMTOOL_PATH=/usr/local/bin/promtool
PROMETHEUS_CONFIG_SYNC_INTERVAL=30s
PROMETHEUS_CONFIG_SYNC_HTTP_TIMEOUT=10s
PROMETHEUS_CONFIG_SYNC_VALIDATION_TIMEOUT=30s
PROMETHEUS_CONFIG_SYNC_MAX_CONFIG_BYTES=10485760
PROMETHEUS_CONFIG_SYNC_MAX_RULES_BYTES=10485760
PROMETHEUS_CONFIG_SYNC_WEB_LISTEN_ADDRESS=:9534
PROMETHEUS_CONFIG_SYNC_WEB_METRICS_PATH=/metrics
